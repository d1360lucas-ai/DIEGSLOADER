	minimizedFrame.Visible = false
	minimizedFrame.Parent = gui
	Instance.new("UICorner", minimizedFrame).CornerRadius = UDim.new(0, 12)

	local function toggleMinimize()
		minimized = not minimized

		if minimized then
			local t = TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 320, 0, 44),
				BackgroundTransparency = 1,
			})
			t:Play()
			t.Completed:Wait()
			frame.Visible = false
			minimizedFrame.Visible = true
		else
			minimizedFrame.Visible = false
			frame.Visible = true
			frame.Size = UDim2.new(0, 320, 0, 44)
			frame.BackgroundTransparency = 1
			TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 320, 0, 520),
				BackgroundTransparency = 0.05,
			}):Play()
		end
	end

	minimizeBtn.MouseButton1Click:Connect(toggleMinimize)
	minimizedFrame.MouseButton1Click:Connect(toggleMinimize)

	-- Close (destroys GUI + restores camera)
	local function closeGui()
		viewingAll = false
		viewAllThreadId += 1
		viewingSingle = false
		setCameraToPlayer(player)
		gui:Destroy()
	end

	closeBtn.MouseButton1Click:Connect(closeGui)

	-- Hotkey M
	UIS.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.M then
			toggleMinimize()
		end
	end)
end)

