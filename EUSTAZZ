local function SanitizeString(str)
    local s = tostring(str)
    return s:gsub("[\x00-\x08\x0b\x0c\x0e-\x1f]", "")
end

local function EscapeXMLString(str)
    local s = SanitizeString(str)
    s = s:gsub("%]%]>", "]]]]><![CDATA[>")
    return s
end

local function EscapeHTML(str)
    local s = SanitizeString(tostring(str))
    s = s:gsub("&", "&amp;")
    s = s:gsub("<", "&lt;")
    s = s:gsub(">", "&gt;")
    s = s:gsub("\"", "&quot;")
    s = s:gsub("'", "&apos;")
    return s
end

local function SerializeValue(value)
    local typ = typeof(value)
    if typ == "string" then
        return EscapeHTML(value)
    elseif typ == "number" then
        if value ~= value or value == math.huge or value == -math.huge then
            return "0"
        end
        return tostring(value)
    elseif typ == "boolean" then
        return tostring(value)
    elseif typ == "Vector3" then
        return string.format("<X>%g</X><Y>%g</Y><Z>%g</Z>", value.X, value.Y, value.Z)
    elseif typ == "Vector2" then
        return string.format("<X>%g</X><Y>%g</Y>", value.X, value.Y)
    elseif typ == "CFrame" then
        return string.format("<X>%g</X><Y>%g</Y><Z>%g</Z><R00>%g</R00><R01>%g</R01><R02>%g</R02><R10>%g</R10><R11>%g</R11><R12>%g</R12><R20>%g</R20><R21>%g</R21><R22>%g</R22>",
            value.X, value.Y, value.Z,
            value.RightVector.X, value.UpVector.X, -value.LookVector.X,
            value.RightVector.Y, value.UpVector.Y, -value.LookVector.Y,
            value.RightVector.Z, value.UpVector.Z, -value.LookVector.Z)
    elseif typ == "Color3" then
        return string.format("<R>%g</R><G>%g</G><B>%g</B>", value.R, value.G, value.B)
    elseif typ == "UDim2" then
        return string.format("<XS>%g</XS><XO>%g</XO><YS>%g</YS><YO>%g</YO>", value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset)
    elseif typ == "UDim" then
        return string.format("<S>%g</S><O>%g</O>", value.Scale, value.Offset)
    elseif typ == "BrickColor" then
        return tostring(value.Number)
    elseif typ == "EnumItem" then
        return tostring(value.Value)
    elseif typ == "NumberSequence" then
        local parts = {}
        for _, kp in ipairs(value.Keypoints) do
            table.insert(parts, string.format("%g %g %g", kp.Time, kp.Value, kp.Envelope))
        end
        return table.concat(parts, ";")
    elseif typ == "ColorSequence" then
        local parts = {}
        for _, kp in ipairs(value.Keypoints) do
            table.insert(parts, string.format("%g %g %g %g", kp.Time, kp.Value.R, kp.Value.G, kp.Value.B))
        end
        return table.concat(parts, ";")
    elseif typ == "NumberRange" then
        return string.format("%g %g", value.Min, value.Max)
    elseif typ == "Rect" then
        return string.format("<min><X>%g</X><Y>%g</Y></min><max><X>%g</X><Y>%g</Y></max>",
            value.Min.X, value.Min.Y, value.Max.X, value.Max.Y)
    elseif typ == "PhysicalProperties" then
        return string.format("<Density>%g</Density><Friction>%g</Friction><Elasticity>%g</Elasticity><FrictionWeight>%g</FrictionWeight><ElasticityWeight>%g</ElasticityWeight>",
            value.Density, value.Friction, value.Elasticity, value.FrictionWeight, value.ElasticityWeight)
    else
        return EscapeHTML(tostring(value))
    end
end

local function GetValueType(value)
    local typ = typeof(value)
    if typ == "string" then
        return "string"
    elseif typ == "boolean" then
        return "bool"
    elseif typ == "number" then
        if value ~= value or value == math.huge or value == -math.huge then
            return "float"
        end
        if value == math.floor(value) and math.abs(value) < 2147483648 then
            return "int"
        else
            return "float"
        end
    elseif typ == "Vector3" then
        return "Vector3"
    elseif typ == "Vector2" then
        return "Vector2"
