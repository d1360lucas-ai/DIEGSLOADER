createAction(empyreanGrid, "BYPASS", "anti Cheat Destroyer only in empyrean", function()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local function destroyEvent(eventName)
        -- Try EmpyreanRP folder
        local empyreanFolder = ReplicatedStorage:FindFirstChild("EmpyreanRP")
        if empyreanFolder then
            local event = empyreanFolder:FindFirstChild(eventName)
            if event and (event:IsA("RemoteEvent") or event:IsA("BindableEvent")) then
                event:Destroy()
                print(`[DestroyEvent] Destroyed in EmpyreanRP: {eventName}`)
                return
            end
        end

        -- Fallback: Remotes folder
        local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
        if remotesFolder then
            local event = remotesFolder:FindFirstChild(eventName)
            if event and (event:IsA("RemoteEvent") or event:IsA("BindableEvent")) then
                event:Destroy()
                print(`[DestroyEvent] Destroyed in Remotes: {eventName}`)
                return
            end
        end

        warn(`[DestroyEvent] Event "{eventName}" not found!`)
    end

    -- Example usage:
    destroyEvent("AntiCheatEvent")
    destroyEvent("AntiCheatReport")
    -- Add more events here if needed
end)

