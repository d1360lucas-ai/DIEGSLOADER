        text = Color3.fromRGB(255,255,255),
        stroke = Color3.fromRGB(255,255,255)
    }
}

local rainbowConnection = nil

local function applyTheme(themeName)
    currentTheme = themeName

    -- Stop rainbow animation if it was active
    if rainbowConnection then
        rainbowConnection:Disconnect()
        rainbowConnection = nil
    end

    local t = themeData[themeName]
    if not t then return end

    if themeName == "Rainbow" then
        local hue = 0
        rainbowConnection = RunService.Heartbeat:Connect(function(dt)
            hue = (hue + dt * 1.05) % 1
            local bright = Color3.fromHSV(hue, 0.9, 1)
            local dark = Color3.fromHSV(hue, 0.85, 0.28)

            mainFrame.BackgroundColor3 = Color3.fromHSV(hue, 0.5, 0.12)
            titleBar.BackgroundColor3 = bright
            tabBar.BackgroundColor3 = bright
            bottomBar.BackgroundColor3 = bright
            searchBG.BackgroundColor3 = dark
            searchBox.BackgroundColor3 = dark

            for _, obj in ipairs(mainFrame:GetDescendants()) do
                if obj:IsA("UIStroke") then
                    obj.Color = bright
                elseif (obj:IsA("Frame") or obj:IsA("TextButton")) 
                   and obj.BackgroundTransparency < 1 
                   and obj.Name ~= "SnowContainer" 
                   and not obj:FindFirstAncestor("SnowContainer") then
                    obj.BackgroundColor3 = dark
                end
            end
        end)
        return
    end

    -- === Normal Theme (Black, Purple, Galaxy, etc.) ===
    mainFrame.BackgroundColor3 = t.bg
    titleBar.BackgroundColor3 = t.accent
    tabBar.BackgroundColor3 = t.accent
    bottomBar.BackgroundColor3 = t.accent
    searchBG.BackgroundColor3 = t.accent
    searchBox.BackgroundColor3 = t.accent

    guiTitle.TextColor3 = t.text

    -- Reset all buttons and frames
    for _, obj in ipairs(mainFrame:GetDescendants()) do
        if obj:IsA("UIStroke") then
            obj.Color = t.stroke
        elseif obj:IsA("Frame") and obj.BackgroundTransparency < 1 and obj.Name ~= "SnowContainer" then
            if obj == searchBG or obj == searchBox or obj.Parent == searchBG then
                obj.BackgroundColor3 = t.accent
            elseif obj.BackgroundColor3.R < 0.3 then  -- Only affect dark elements
                obj.BackgroundColor3 = t.accent
            end
        elseif obj:IsA("TextButton") and obj.BackgroundTransparency < 1 then
            obj.BackgroundColor3 = t.accent
        end
    end
end

