    for _, flake in ipairs(snowflakes) do
        local f = flake.Frame
        local p = f.Position

        local newY = p.Y.Scale + dt * flake.Speed
        local newX = p.X.Scale + dt * flake.Drift

        f.Position = UDim2.new(newX, 0, newY, 0)

        -- Reset only within GUI bounds
        if newY > 1.05 then
            f.Position = UDim2.new(math.random(), 0, -0.15, 0)
            flake.Drift = math.random(-18, 18) / 1000
        end

        -- Gentle rotation
        f.Rotation = (f.Rotation + dt * 35) % 360
    end
end)

