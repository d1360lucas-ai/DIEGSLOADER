            dragging = false
        end
    end)

    textBox.FocusLost:Connect(function(enter)
        if enter then
            local num = tonumber(textBox.Text)
            if num then applyValue(math.clamp(num, min, max)) end
        end
    end)

    updateVisual(Settings[name])
    yOffset = yOffset + 80
