local function GetSourceCode(script)
    if decompilestring then
        local ok, src = pcall(decompilestring, script)
        if ok and src and #src > 0 then return src end
    end
    if decompile then
        local ok, src = pcall(decompile, script)
        if ok and src and #src > 0 then return src end
    end
    if getscriptbytecode and decompile then
        local ok, bc = pcall(getscriptbytecode, script)
        if ok and bc then
            local ok2, src = pcall(decompile, bc)
            if ok2 and src and #src > 0 then return src end
        end
    end
    if getscriptsource then
        local ok, src = pcall(getscriptsource, script)
        if ok and src and #src > 0 then return src end
    end
    local ok, src = pcall(function()
        return script.Source
    end)
    if ok and src and type(src) == "string" and #src > 0 then
        return src
    end
    return "-- [Source unavailable: protected by Roblox]"
end

