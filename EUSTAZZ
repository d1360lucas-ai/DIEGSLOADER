local function SerializeInstance(instance, xmlLines, depth)
    local indent = string.rep("  ", depth)
    local className = instance.ClassName
    local name = ""
    local ok, nm = pcall(function() return instance.Name end)
    if ok then name = SanitizeString(nm) end

    local ref = string.format("RBX%08X", #xmlLines) -- dummy referent

    AddOutputLine(string.format("> [%d] %s \"%s\"", #xmlLines, className, name))
    task.wait()

    table.insert(xmlLines, indent .. string.format("<Item class=\"%s\" referent=\"%s\">", EscapeHTML(className), ref))
    table.insert(xmlLines, indent .. "  <Properties>")
    table.insert(xmlLines, indent .. string.format("    <string name=\"Name\">%s</string>", EscapeHTML(name)))

    -- Extract source for scripts
    if className == "Script" or className == "LocalScript" or className == "ModuleScript" then
        local src = GetSourceCode(instance)
        table.insert(xmlLines, indent .. "    <ProtectedString name=\"Source\"><![CDATA[" .. EscapeXMLString(src) .. "]]></ProtectedString>")
        AddOutputLine(string.format("    src: %d chars [%s]", #src, name))
        task.wait()
    end

    -- Extract properties based on class
    local props = PropertiesToExtract[className] or {}
    for _, propName in ipairs(props) do
        local ok, value = pcall(function() return instance[propName] end)
        if ok and value ~= nil then
            local valType = GetValueType(value)
            table.insert(xmlLines, indent .. string.format("    <%s name=\"%s\">%s</%s>", valType, EscapeHTML(propName), SerializeValue(value), valType))
        end
    end

    -- Extract attributes
    local attrOk, attrs = pcall(function() return instance:GetAttributes() end)
    if attrOk and attrs then
        for attrName, attrValue in pairs(attrs) do
            local valType = GetValueType(attrValue)
            table.insert(xmlLines, indent .. string.format("    <%s name=\"attr_%s\">%s</%s>", valType, EscapeHTML(tostring(attrName)), SerializeValue(attrValue), valType))
        end
    end

    table.insert(xmlLines, indent .. "  </Properties>")

    -- Recurse children
    local childOk, children = pcall(function() return instance:GetChildren() end)
    if childOk then
        for _, child in ipairs(children) do
            SerializeInstance(child, xmlLines, depth + 1)
        end
    end

    table.insert(xmlLines, indent .. "</Item>")
end

