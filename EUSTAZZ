	-- State
	local selectedPlayer: Player? = nil
	local viewingAll = false
	local viewingSingle = false
	local currentIndex = 0
	local viewAllThreadId = 0
	local minimized = false

	local function updateInfoForSelected()
		if not selectedPlayer then
			info.Text = "Selected: None\nHealth: N/A"
			return
		end
		local hum = getHumanoid(selectedPlayer)
		local hp = hum and math.floor(hum.Health) or "N/A"
		info.Text = ("Selected: %s\nHealth: %s"):format(selectedPlayer.Name, tostring(hp))
	end

	local function refreshPlayerList()
		for _, child in ipairs(playerList:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		for _, plr in ipairs(Players:GetPlayers()) do
