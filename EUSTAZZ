local function isYellowTrash(part)
    if not part or not part:IsA("BasePart") then return false end
    if part.Transparency > 0.6 then return false end
    local color = part.Color
    if (color.R > 0.85 and color.G > 0.85 and color.B < 0.4) then return true end
    local name = part.Name:lower()
    return name:find("yellow") or name:find("trash") or name:find("spot") or name:find("mop") or name:find("broom")
end

local function getYellowSpots()
    local spots = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isYellowTrash(obj) then
            local pos = obj.Position
            local key = math.floor(pos.X/3) .. "," .. math.floor(pos.Y/3) .. "," .. math.floor(pos.Z/3)
            if not cleanedSpots[key] then
                table.insert(spots, {part = obj, key = key, pos = pos})
            end
        end
    end
    return spots
end

local function walkTo(targetPos)
    local target = targetPos + Vector3.new(0, 3.5, 0)
    
    if currentMethod == "Direct" then
        humanoid:MoveTo(target)
        local finished = humanoid.MoveToFinished:Wait(4)
        if not finished then
            humanoid:MoveTo(target)
        end
        return
    elseif currentMethod == "Auto" then
        local path = PathfindingService:CreatePath({
            AgentRadius = 3,
            AgentHeight = 5.5,
            AgentCanJump = true,
            WaypointSpacing = 4
        })
        path:ComputeAsync(root.Position, target)
        
        if path.Status == Enum.PathStatus.Success then
            for _, wp in ipairs(path:GetWaypoints()) do
                if not isEnabled then break end
                humanoid:MoveTo(wp.Position + Vector3.new(0, 3, 0))
                humanoid.MoveToFinished:Wait(0.6)
            end
        else
            humanoid:MoveTo(target)
            humanoid.MoveToFinished:Wait(3)
        end
        return
    end
    
    -- Default: Pathfinding
    local path = PathfindingService:CreatePath({
        AgentRadius = 2.8,
        AgentHeight = 5,
        AgentCanJump = true,
        WaypointSpacing = 3
    })
    path:ComputeAsync(root.Position, target)
    
    if path.Status == Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do
            if not isEnabled then break end
            humanoid:MoveTo(wp.Position)
            humanoid.MoveToFinished:Wait(0.75 + math.random(15,35)/100)
        end
    else
        humanoid:MoveTo(target)
        humanoid.MoveToFinished:Wait(3)
    end
end

local function performClean()
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local txt = prompt.ActionText:lower()
            if txt:find("clean") or txt:find("mop") or txt:find("sweep") or txt:find("empty") then
                local dist = (prompt.Parent.Position - root.Position).Magnitude
                if dist < 15 then
                    prompt:InputHoldBegin()
                    task.wait(1 + math.random(4,12)/10)
                    prompt:InputHoldEnd()
                    return true
                end
            end
        end
    end
    task.wait(0.6)
    return false
end

-- Main Loop
task.spawn(function()
    while true do
        task.wait(0.4)
        if not isEnabled or not root or not root.Parent then continue end

        updateRemainingActions()
        
        NeedToCleanLabel.Text = "Need to Clean: " .. remainingActions
        CurrentMethodLabel.Text = "Current Method: " .. currentMethod

        local spots = getYellowSpots()

        if #spots > 0 then
            table.sort(spots, function(a, b)
                return (a.pos - root.Position).Magnitude < (b.pos - root.Position).Magnitude
            end)

            local target = spots[1]
            walkTo(target.pos)

            if isEnabled then
                local success = performClean()
                if success then
                    cleanedSpots[target.key] = true
                    cleanedCount = cleanedCount + 1
                    remainingActions = math.max(0, remainingActions - 1)
                    task.wait(0.6 + math.random(5,14)/10)
                end
            end
        else
            task.wait(1.5)
            if cleanedCount >= totalActions - 10 then
                cleanedSpots = {}
            end
        end
    end
end)

