		if viewingAll then
			viewingAll = false
			viewAllBtn.Text = "View All: OFF"
			viewAllBtn.BackgroundColor3 = COLORS.RED
		end

		if viewingSingle then
			setCameraToPlayer(player)
			viewingSingle = false
			viewBtn.Text = "View Player"
			updateInfoForSelected()
			return
		end

		if selectedPlayer and setCameraToPlayer(selectedPlayer) then
			viewingSingle = true
			viewBtn.Text = "Unview Player"
			info.Text = ("Viewing: %s"):format(selectedPlayer.Name)
		else
			info.Text = "Can't view (no character/humanoid)."
		end
	end)

	-- Teleport
	tpBtn.MouseButton1Click:Connect(function()
		if not selectedPlayer then return end
		local targetHRP = getHRP(selectedPlayer)
		local myChar = player.Character
		if myChar and targetHRP then
			myChar:MoveTo(targetHRP.Position + Vector3.new(0, 2, 0))
		end
	end)

	-- Bring
	bringBtn.MouseButton1Click:Connect(function()
		if not selectedPlayer then return end
		local myHRP = getHRP(player)
		local targetChar = selectedPlayer.Character
		if myHRP and targetChar then
			targetChar:MoveTo(myHRP.Position + Vector3.new(2, 0, 0))
		end
	end)

	-- Add friend
	addBtn.MouseButton1Click:Connect(function()
		if selectedPlayer then
			player:RequestFriendship(selectedPlayer)
		end
	end)

	-- View All
	viewAllBtn.MouseButton1Click:Connect(function()
		viewingAll = not viewingAll
		viewAllThreadId += 1
		local myThreadId = viewAllThreadId

		if viewingAll then
			viewingSingle = false
			viewBtn.Text = "View Player"

			viewAllBtn.Text = "View All: ON"
			viewAllBtn.BackgroundColor3 = COLORS.GREEN
			info.Text = "Viewing all players..."
			currentIndex = 0

			task.spawn(function()
				while viewingAll and viewAllThreadId == myThreadId do
					local all = Players:GetPlayers()
					if #all > 0 then
						currentIndex += 1
						if currentIndex > #all then currentIndex = 1 end
						local target = all[currentIndex]
						if target and setCameraToPlayer(target) then
							info.Text = ("Viewing: %s"):format(target.Name)
						end
					end
					task.wait(3)
				end
			end)
		else
			viewAllBtn.Text = "View All: OFF"
			viewAllBtn.BackgroundColor3 = COLORS.RED
			setCameraToPlayer(player)
			updateInfoForSelected()
		end
	end)

