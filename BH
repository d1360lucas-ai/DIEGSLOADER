local function OFBCBY_fake_script()
	local script = Instance.new("LocalScript", Knob)

	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")

	local knob = script.Parent
	local sliderBar = knob.Parent
	local filling = sliderBar:FindFirstChild("Filling")
	local valueLabel = sliderBar.Parent:FindFirstChild("TextLabel")

	local dragging = false
	local activeInput = nil

	_G.CurrentSizeValue = 1
	_G.BigheadMasterState = false

local function disableEverything()
	_G.BigheadMasterState = false
	_G.CurrentSizeValue = 1

	dragging = false
	activeInput = nil

	if UI and UI.Parent then
		UI:Destroy()
	end
end

CloseButton.Activated:Connect(disableEverything)

	--// =========================
	--// BYPASS
	--// =========================

	local function startBypass()
		for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
			if obj.Name == "Unknown" then
				obj:Destroy()
			end
		end

		ReplicatedStorage.DescendantAdded:Connect(function(obj)
			if obj.Name == "Unknown" then
				obj:Destroy()
			end
		end)

		task.wait(0.5)
		_G.BigheadMasterState = true
	end

	--// =========================
	--// APPLY SIZE
	--// =========================

	_G.ApplyToPlayer = function(player)
		if player == Players.LocalPlayer then
			return
		end

		local character = player.Character
		if not character then
			return
		end

		local head = character:FindFirstChild("Head")
		if not head then
			return
		end

		pcall(function()
			local size = _G.CurrentSizeValue

			head.Size = Vector3.new(size, size, size)
			head.Transparency = 0.4
			head.BrickColor = BrickColor.new("Really red")
			head.Material = Enum.Material.Neon
			head.CanCollide = false
			head.Massless = true
		end)
	end

	--// =========================
	--// SLIDER
	--// =========================

	local MIN_VALUE = 1
	local MAX_VALUE = 10

	local function setSliderFromX(x)
		local barPosition = sliderBar.AbsolutePosition.X
		local barSize = sliderBar.AbsoluteSize.X

		if barSize <= 0 then
			return
		end

		local percent = math.clamp(
			(x - barPosition) / barSize,
			0,
			1
		)

		-- Position ng knob
		knob.Position = UDim2.new(
			percent,
			0,
			0.5,
			0
		)

		-- Filling
		if filling then
			filling.Size = UDim2.new(
				percent,
				0,
				1,
				0
			)
		end

		-- Value
		local value = math.floor(
			MIN_VALUE + ((MAX_VALUE - MIN_VALUE) * percent) + 0.5
		)

		_G.CurrentSizeValue = value

		if valueLabel then
			valueLabel.Text = tostring(value)
		end
	end

	local function beginDrag(input)
		dragging = true
		activeInput = input

		local x

		if input.UserInputType == Enum.UserInputType.Touch then
			x = input.Position.X
		else
			x = UserInputService:GetMouseLocation().X
		end

		setSliderFromX(x)
	end

	local function endDrag(input)
		if input == activeInput
			or input.UserInputType == Enum.UserInputType.MouseButton1 then

			dragging = false
			activeInput = nil
		end
	end

	--// Click/touch anywhere on slider
	sliderBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			beginDrag(input)
		end
	end)

	--// Knob itself
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			beginDrag(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local x = input.Position.X
			setSliderFromX(x)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		endDrag(input)
	end)

	--// =========================
	--// INITIAL VALUE
	--// =========================

	task.defer(function()
		setSliderFromX(
			sliderBar.AbsolutePosition.X
			+ sliderBar.AbsoluteSize.X * 0
		)
	end)

	--// =========================
	--// UPDATE PLAYERS
	--// =========================

	RunService.RenderStepped:Connect(function()
		if _G.BigheadMasterState then
			for _, player in ipairs(Players:GetPlayers()) do
				_G.ApplyToPlayer(player)
			end
		end
	end)

	--// =========================
	--// START
	--// =========================

	startBypass()

	for _, player in ipairs(Players:GetPlayers()) do
		applyESPAndLogic(player)
	end

	Players.PlayerAdded:Connect(applyESPAndLogic)
end

coroutine.wrap(OFBCBY_fake_script)()
